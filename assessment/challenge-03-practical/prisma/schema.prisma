// schema.prisma - Database Schema for GDG SVEC EventHub
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Attendee {
  id          String   @id @default(uuid())
  fullName    String
  email       String   @unique
  rollNumber  String   @unique
  department  String
  year        String
  phone       String?
  registeredAt DateTime @default(now())
  
  ticket      Ticket?
}

model Ticket {
  id          String   @id // e.g. "TICK-GDG-XXXXXX"
  attendeeId  String   @unique
  attendee    Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  qrPayload   String   // Safe ticket identifier
  status      String   @default("ISSUED") // ISSUED | CHECKED_IN | CANCELLED
  issuedAt    DateTime @default(now())

  checkIn     CheckIn?
}

model CheckIn {
  id          String   @id @default(uuid())
  ticketId    String   @unique
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  scannedAt   DateTime @default(now())
  scannedBy   String   @default("ORGANIZER_DESK")
  deviceInfo  String?
}
