# Environment Configuration Template for GDG SVEC EventHub
# Copy this file to .env for local development

NODE_ENV=development
PORT=3000

# Database Connection (SQLite relational storage)
DATABASE_URL="file:./dev.db"

# Event Configuration
NEXT_PUBLIC_EVENT_NAME="GDG DevFest SVEC 2026"
NEXT_PUBLIC_EVENT_LOCATION="Main Auditorium, SVEC Campus"
NEXT_PUBLIC_EVENT_DATE="September 20, 2026"

# Admin Authentication Token (Placeholder for local organizer testing)
ADMIN_API_KEY="dev_admin_secret_key_change_in_production"
